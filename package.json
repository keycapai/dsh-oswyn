{
  "name": "dsh-oswyn",
  "version": "1.6.8",
  "description": "DSH-OSWYN (Only See What You Need) — Agent-guided context optimization & prompt-cache preserving management: cache-preserving prefix truncation, fact replacement, dual-track assistant reply projection, and live dashboard.",
