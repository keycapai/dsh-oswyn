{
  "name": "dsh-oswyn",
  "version": "2.1.0",
  "description": "DSH-OSWYN (Only See What You Need) — Agent-guided in-band step-boundary context micro-distillation & prompt-cache preserving management for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "author": "keycapai",
  "license": "MIT",
  "homepage": "https://github.com/keycapai/dsh-oswyn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keycapai/dsh-oswyn.git"
  },
  "bugs": {
    "url": "https://github.com/keycapai/dsh-oswyn/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "context-distillation",
    "prompt-cache",
    "kv-cache",
    "ai-agents",
    "swe-agent",
    "keycapai"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build:client": "node lib/client/build.js",
    "prepublishOnly": "node lib/client/build.js",
    "test": "node lib/client/build.js && node --test test/*.test.js"
  }
}
